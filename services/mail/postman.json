{
  "info": {
    "name": "Mail Service",
    "_postman_id": "mail-service-collection",
    "description": "Internal transactional email delivery service. These routes are NOT exposed through the API Gateway — they are called directly by other services (e.g. the users service). Use base_url pointing directly at the mail service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8085", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "description": "Liveness check. Returns {\"status\": \"ok\"} when the service is healthy.",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Internal",
      "description": "Internal endpoints consumed by other services. Not routed through the API Gateway.",
      "item": [
        {
          "name": "Send Verification Email",
          "request": {
            "method": "POST",
            "description": "Dispatch an email verification link to a user. Called by the users service after registration or when resending.",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/internal/mail/verification",
              "host": ["{{base_url}}"],
              "path": ["internal", "mail", "verification"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"to_email\": \"user@example.com\",\n  \"username\": \"myusername\",\n  \"verification_link\": \"http://localhost:5173/auth/verify-email?token=TOKEN\"\n}"
            }
          }
        },
        {
          "name": "Send Document Share Email",
          "request": {
            "method": "POST",
            "description": "Notify a user that a document has been shared with them. Called by the kitchen service after a share is created.",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/internal/mail/document-share",
              "host": ["{{base_url}}"],
              "path": ["internal", "mail", "document-share"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"to_email\": \"collaborator@example.com\",\n  \"document_title\": \"My Document\",\n  \"document_link\": \"http://localhost:5173/docs/DOCUMENT_ID\",\n  \"role\": \"editor\"\n}"
            }
          }
        }
      ]
    }
  ]
}
