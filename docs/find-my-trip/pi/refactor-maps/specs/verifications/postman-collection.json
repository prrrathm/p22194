{
  "info": {
    "name": "Find My Trip API Audit",
    "description": "Validation collection for find-my-trip service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "POST /location/group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"latitude\": 37.7749, \"longitude\": -122.4194}"
            },
            "url": { "raw": "http://localhost:8000/location/group" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status code is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "POST /location/places",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"latitude\": 37.7749, \"longitude\": -122.4194}"
            },
            "url": { "raw": "http://localhost:8000/location/places" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status code is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "POST /location/activities",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
